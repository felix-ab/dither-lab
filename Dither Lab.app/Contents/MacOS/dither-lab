#!/bin/bash
# Dither Lab launcher: make sure the localhost server is up, then open the app in its own window.
# Keep this .app inside its dither-lab folder — drag it to the Dock rather than moving it.
PORT=4560
URL="http://localhost:$PORT/"
ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
SERVE="$ROOT/tools/serve.py"

alert() {
  /usr/bin/osascript -e "display alert \"Dither Lab\" message \"$1\" as critical" >/dev/null 2>&1
}
up() { /usr/bin/curl -fsS --max-time 1 "${URL}manifest.json" 2>/dev/null | /usr/bin/grep -q "Dither Lab"; }

if [ ! -f "$SERVE" ]; then
  alert "Can't find tools/serve.py next to the app. Keep “Dither Lab.app” inside its dither-lab folder (drag it to the Dock instead of moving it)."
  exit 1
fi

if ! up; then
  PY=""
  for c in /opt/homebrew/bin/python3 /usr/local/bin/python3 /opt/anaconda3/bin/python3 /usr/bin/python3; do
    if [ -x "$c" ]; then PY="$c"; break; fi
  done
  if [ -z "$PY" ]; then
    alert "Python 3 is needed to serve Dither Lab locally (install the Xcode Command Line Tools: xcode-select --install)."
    exit 1
  fi
  /usr/bin/nohup "$PY" "$SERVE" --port "$PORT" >"${TMPDIR:-/tmp}/dither-lab-server.log" 2>&1 &
  for _ in $(seq 1 50); do up && break; sleep 0.1; done
  if ! up; then
    alert "The local server didn't start. See ${TMPDIR:-/tmp}dither-lab-server.log"
    exit 1
  fi
fi

[ "$DITHERLAB_NO_OPEN" = "1" ] && exit 0
if [ -d "/Applications/Google Chrome.app" ] || [ -d "$HOME/Applications/Google Chrome.app" ]; then
  /usr/bin/open -na "Google Chrome" --args --app="$URL"
else
  /usr/bin/open "$URL"
fi
